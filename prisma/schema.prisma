generator client {
  provider = "prisma-client-js"
  output   = "../generated-prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  whatsapp
  telegram
}

enum LeadSource {
  site
  telegram_bot
}

model LandingPage {
  id                    String   @id @default(cuid())
  urlPath               String   @unique
  name                  String
  headerPhrase          String
  heroImage             String?
  heroHeading           String
  heroDescription       String
  heroSupport           String
  buttonLabel           String
  contact               String
  videoUrl              String
  nextScreenTitle       String
  nextScreenDescription String
  nextScreenQuestion    String
  telegramEnabled       Boolean  @default(true)
  whatsappEnabled       Boolean  @default(true)
  customScript          String?
  telegramBotToken      String?
  telegramChatIds       String?
  logoPath              String   @default("/assets/images/logo.webp")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  leads                 Lead[]
}

model Lead {
  id            String       @id @default(cuid())
  channel       Channel
  source        LeadSource   @default(site)
  contact       String
  message       String?
  ipAddress     String?
  country       String?
  landingPageId String?
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id])
  pagePath      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  gclid         String?
  gbraid        String?
  wbraid        String?
  fbclid        String?
  createdAt     DateTime     @default(now())
}

model LandingContent {
  id                   String   @id
  defaultLandingName   String   @default("Главная страница")
  headerPhrase         String
  heroImage            String?
  heroHeading          String
  heroDescription      String
  heroSupport          String
  buttonLabel          String
  contact              String
  videoUrl             String
  nextScreenTitle      String
  nextScreenDescription String
  nextScreenQuestion   String
  telegramEnabled      Boolean  @default(true)
  whatsappEnabled      Boolean  @default(true)
  customScript         String?
  telegramBotToken     String?
  telegramChatIds      String?
  logoPath             String   @default("/assets/images/logo.webp")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model QuizBotSettings {
  id                String   @id
  enabled           Boolean  @default(true)
  welcomeMessage    String
  startButtonLabel  String   @default("ПОДОБРАТЬ НЕДВИЖИМОСТЬ →")
  completionMessage String
  managerContactUrl String?
  channelUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model QuizBotSession {
  id             String    @id @default(cuid())
  chatId         String    @unique
  telegramUserId String?
  username       String?
  firstName      String?
  lastName       String?
  step           String    @default("idle")
  startParam     String?
  answers        Json      @default("{}")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
